{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/download",
      "destination": "/zen-master-v0.1.4.zip"
    }
  ],
  "headers": [
    {
      "source": "/download",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"zen-master-v0.1.4.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
