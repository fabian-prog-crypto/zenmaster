{
  "name": "zen-master-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test:adapters": "vitest run tests/adapters",
    "test:performance": "vitest run tests/performance",
    "test:extension": "playwright test",
    "test:coverage": "vitest run --coverage tests/unit tests/adapters",
    "fixture:generate": "node scripts/generate-fixtures.mjs",
    "fixture:validate": "node scripts/validate-fixtures.mjs",
    "check:package": "node scripts/check-package.mjs",
    "package": "node scripts/package.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:adapters",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run fixture:validate && npm run test:coverage && npm run test:performance && npm run build && npm run check:package && npm run test:extension"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.8",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "fflate": "0.8.3",
    "happy-dom": "20.14.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
